# OpenRouter API Key (primary LLM)
OPENROUTER_API_KEY=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

# ElevenLabs API Key (for video audio transcription and processing)
ELEVENLABS_API_KEY=sk_b0eade070e022ca8fb87f4724ade7ea8beb84ed300fa91e3

# Application Settings
FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=50000000

# Video Processing Settings
MAX_VIDEO_SIZE=200000000
MAX_VIDEO_DURATION=1800

# Dual-LLM Verification (optional - increases accuracy but slower and more expensive)
# Set to 'true' to enable cross-verification with a second LLM
ENABLE_DUAL_LLM=false
VERIFICATION_MODEL=openai/gpt-4o-mini
GEMINI_MODEL=google/gemini-2.5-flash